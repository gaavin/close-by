{
	"name": "close-by",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"cf-typegen": "wrangler types",
		"migrations:remote": "wrangler d1 migrations apply close-by --remote",
		"migrations:local": "wrangler d1 migrations apply close-by --local",
		"migrations:generate": "drizzle-kit generate",
		"predev": "pnpm run cf-typegen && pnpm run migrations:local",
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "pnpm run migrations:remote && pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.40",
		"@paralleldrive/cuid2": "^3.3",
		"@tailwindcss/vite": "^4.3",
		"@tanstack/react-devtools": "^0.10",
		"@tanstack/react-router": "^1.170",
		"@tanstack/react-router-devtools": "^1.167",
		"@tanstack/react-router-ssr-query": "^1.167",
		"@tanstack/react-start": "^1.168",
		"@tanstack/router-plugin": "^1.168",
		"drizzle-orm": "^0.45",
		"react": "^19.2",
		"react-dom": "^19.2",
		"tailwindcss": "^4.3",
		"zod": "^4.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5",
		"@rolldown/plugin-babel": "^0.2",
		"@tanstack/devtools-vite": "^0.7",
		"@tanstack/router-cli": "^1.167",
		"@types/node": "^25.9",
		"@types/react": "^19.2",
		"@types/react-dom": "^19.2",
		"@vitejs/plugin-react": "^6.0",
		"@vitejs/plugin-rsc": "^0.5",
		"babel-plugin-react-compiler": "^1.0",
		"drizzle-kit": "^0.31",
		"typescript": "^6.0",
		"vite": "^8.0",
		"wrangler": "^4.101"
	}
}
