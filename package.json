{
	"name": "close-by",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"packages:upgrade": "ncu -u",
		"cf:typegen": "wrangler types",
		"migrations:remote": "wrangler d1 migrations apply close-by --remote",
		"migrations:local": "wrangler d1 migrations apply close-by --local",
		"migrations:generate": "drizzle-kit generate",
		"predev": "pnpm run cf:typegen &&pnpm run routes:generate && pnpm run migrations:local",
		"dev": "vite dev --port 3000",
		"routes:generate": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "pnpm run migrations:remote && pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.42.2",
		"@paralleldrive/cuid2": "^3.3.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/react-devtools": "^0.10",
		"@tanstack/react-router": "^1.170",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.26",
		"@tanstack/router-plugin": "^1.168.18",
		"drizzle-orm": "^0.45.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/devtools-vite": "^0.8.1",
		"@tanstack/router-cli": "^1.167.17",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitejs/plugin-rsc": "^0.5.27",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"npm-check-updates": "^22.2.7",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"wrangler": "^4.104.0"
	}
}
